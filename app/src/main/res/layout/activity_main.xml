<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vezel_bg">

    <com.vezel.launcher.ui.DashboardView
        android:id="@+id/dashboardView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/appsPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/vezel_bg"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/apps_title"
                android:textColor="@color/vezel_text"
                android:textSize="22sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnRefreshApps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/apps_refresh" />

            <Button
                android:id="@+id/btnBackDashboard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/back_dashboard" />
        </LinearLayout>

        <TextView
            android:id="@+id/appsEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="@string/apps_empty"
            android:textColor="@color/vezel_text_muted"
            android:textSize="16sp"
            android:visibility="gone" />

        <GridView
            android:id="@+id/appsGrid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:horizontalSpacing="12dp"
            android:numColumns="6"
            android:verticalSpacing="12dp" />
    </LinearLayout>
</FrameLayout>
